# Web app only. Copy to .env.local for a NEW checkout; keep an existing configured file.
# This template contains placeholders. Never commit actual local settings.
# Do not add a Supabase secret/service-role key, SMTP password or Resend API key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# The single school this deployment serves (a row in public.schools).
SCHOOL_PORTAL_SCHOOL_ID=00000000-0000-4000-8000-000000000000

# Trusted email-link origin. Match the local server's 127.0.0.1 address.
# Keep email OFF until the sending domain, SMTP, templates and redirects are tested.
SCHOOL_PORTAL_SITE_URL=http://127.0.0.1:3000
SCHOOL_PORTAL_EMAIL_ENABLED=false
SCHOOL_PORTAL_INVITATIONS_ENABLED=false

# CLI redirect values and Edge Function settings belong to separate runtimes.
# See docs/ENVIRONMENT.md; do not copy their privileged credentials into the app.
