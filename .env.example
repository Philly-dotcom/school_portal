# Copy to .env.local for local development. Never commit real values.
# Browser-visible by design: Supabase project URL and PUBLISHABLE key only.
# Never put an sb_secret_ key or the service_role key in this file (the app refuses sb_secret_ keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# The single school this deployment serves (a row in public.schools).
SCHOOL_PORTAL_SCHOOL_ID=00000000-0000-4000-8000-000000000000

# Email flows stay OFF until SMTP, templates and redirect URLs are configured (docs/ACCOUNT_MANAGEMENT.md).
SCHOOL_PORTAL_SITE_URL=http://localhost:3000
SCHOOL_PORTAL_EMAIL_ENABLED=false
SCHOOL_PORTAL_INVITATIONS_ENABLED=false
